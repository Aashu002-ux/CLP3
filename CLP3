import random
import numpy as np

def product(lst):
    result = 1
    for num in lst:
        result *= num
    return result

def fitness(individual, target):
    prod = product(individual)
    
    if prod == 0:
        return 0
    return 1 / (1 + abs(target - prod))

def mutate(individual, mutation_rate=0.1):
    return [random.randint(0, 9) if random.random() < mutation_rate else gene for gene in individual]

def crossover(parent1, parent2):
    point = random.randint(1, len(parent1)-1)
    return parent1[:point] + parent2[point:]

def select(population, fitnesses):
    total_fitness = sum(fitnesses)
    probs = [f / total_fitness for f in fitnesses]
    return population[np.random.choice(len(population), p=probs)]

def evolve(T, k, generations=1000, population_size=200, mutation_rate=0.1):
   
    population = [ [random.randint(0, 9) for _ in range(k)] for _ in range(population_size) ]

    for generation in range(generations):
        fitnesses = [fitness(ind, T) for ind in population]

        
        for ind in population:
            if product(ind) == T:
                return ind

        
        next_generation = []
        for _ in range(population_size):
            parent1 = select(population, fitnesses)
            parent2 = select(population, fitnesses)
            child = crossover(parent1, parent2)
            child = mutate(child, mutation_rate)
            next_generation.append(child)

        population = next_generation

    return None 


result1 = evolve(12, 3)
result2 = evolve(18, 3)

print("Case#1 Output:", *result1 if result1 else ["No solution"])
print("Case#2 Output:", *result2 if result2 else ["No solution"])
